@using Aura.Core.Models
@model Event

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.CoupleNames - Wedding Invitation</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=@(Model.Template?.FontFamily?.Replace(" ", "+") ?? "Playfair+Display"):wght@400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '@(Model.Template?.PrimaryColor ?? "#8b5a54")',
                        secondary: '@(Model.Template?.SecondaryColor ?? "#fdfbf7")',
                        accent: '#D3BDBB'
                    },
                    fontFamily: {
                        heading: ['@(Model.Template?.FontFamily ?? "Playfair Display")', 'serif'],
                        body: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        .hero-overlay {
            background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);
        }
    </style>
</head>
<body class="bg-secondary text-gray-800 font-body antialiased selection:bg-primary selection:text-white">
    
    <!-- Hero Section -->
    <header class="relative w-full h-[80vh] md:h-screen flex items-center justify-center overflow-hidden">
        @if (!string.IsNullOrEmpty(Model.HeroImageUrl))
        {
            <img src="@Model.HeroImageUrl" alt="@Model.CoupleNames" class="absolute inset-0 w-full h-full object-cover" />
        }
        else
        {
            <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2000&q=80" alt="Wedding placeholder" class="absolute inset-0 w-full h-full object-cover" />
        }
        <div class="absolute inset-0 hero-overlay"></div>
        
        <div class="relative z-10 text-center px-6 glass-panel py-12 md:px-16 rounded-3xl mx-4 max-w-3xl animate-fade-in-up">
            <span class="text-white/90 uppercase tracking-[0.3em] text-xs font-semibold mb-4 block">We invite you to celebrate</span>
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-heading text-white mb-6 drop-shadow-sm">@Model.CoupleNames</h1>
            <p class="text-white/90 text-lg md:text-xl font-light mb-8 tracking-wide">
                @Model.EventDate.ToString("dddd, MMMM d, yyyy")
            </p>
            <a href="#rsvp" class="inline-block bg-white text-primary px-8 py-3 rounded-full font-medium tracking-wide hover:bg-gray-50 transition-all shadow-lg transform hover:-translate-y-1">
                RSVP Now
            </a>
        </div>
    </header>

    <!-- Details Section -->
    <main class="py-24 px-6 max-w-5xl mx-auto">
        <div class="text-center mb-20">
            <h2 class="text-4xl md:text-5xl font-heading text-primary mb-6">The Details</h2>
            <div class="w-16 h-px bg-primary/30 mx-auto"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
            <div class="text-center flex flex-col items-center">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-6">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <h3 class="text-2xl font-heading text-gray-900 mb-2">When</h3>
                <p class="text-gray-600 font-light text-lg">@Model.EventDate.ToString("MMMM d, yyyy")</p>
                <p class="text-gray-600 font-light text-lg mb-6">@Model.EventDate.ToString("h:mm tt")</p>
                <a href="#" id="add-to-calendar-btn" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors uppercase tracking-wider">Add to Calendar</a>
            </div>

            <div class="text-center flex flex-col items-center">
                <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-6">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <h3 class="text-2xl font-heading text-gray-900 mb-2">Where</h3>
                <p class="text-gray-600 font-light text-lg">@Model.VenueName</p>
                <p class="text-gray-600 font-light text-lg mb-6 max-w-xs mx-auto">@Model.VenueAddress</p>
                <a href="https://www.google.com/maps/dir/?api=1&destination=@Uri.EscapeDataString(Model.VenueAddress)" target="_blank" class="text-sm font-medium text-primary hover:text-primary/80 transition-colors uppercase tracking-wider">Get Directions</a>
            </div>
        </div>
    </main>

    <!-- RSVP Section -->
    <section id="rsvp" class="bg-white py-24 border-t border-gray-100">
        <div class="max-w-3xl mx-auto px-6 text-center">
            <h2 class="text-4xl md:text-5xl font-heading text-primary mb-6">Will you join us?</h2>
            <p class="text-gray-600 text-lg mb-10 font-light">Please let us know if you can make it by entering your personal RSVP link.</p>
            <div class="flex justify-center">
                <a href="/rsvp" class="bg-primary text-white px-10 py-4 rounded-full font-medium tracking-wide hover:bg-primary/90 transition-all shadow-md transform hover:-translate-y-1">
                    Respond via Guest Link
                </a>
            </div>
        </div>
    </section>

    <footer class="bg-primary text-white/80 py-12 text-center">
        <p class="font-heading text-2xl text-white mb-4">@Model.CoupleNames</p>
        <p class="text-sm tracking-wider uppercase opacity-70">&copy; @DateTime.UtcNow.Year. All rights reserved.</p>
    </footer>

    <script src="app.js"></script>
    <script>
        window.eventData = {
            name: '@Model.Name',
            date: '@Model.EventDate.ToString("O")',
            venue: '@Model.VenueName',
            address: '@Model.VenueAddress'
        };
    </script>
</body>
</html>
