@using Aura.Core.Models
@model Event

:root {
    --primary-color: @(Model.PrimaryColor ?? "#000000");
    --secondary-color: @(Model.SecondaryColor ?? "#ffffff");
    --font-family: '@(Model.FontFamily ?? "Arial")', sans-serif;
    --hero-image-url: @Raw(string.IsNullOrEmpty(Model.HeroImageUrl) ? "none" : $"url('{Model.HeroImageUrl}')");
    --hero-overlay: @Raw(string.IsNullOrEmpty(Model.HeroImageUrl) ? "none" : "linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4))");
}

body {
    font-family: var(--font-family);
    margin: 0;
    padding: 0;
    color: #333;
    line-height: 1.6;
    background-color: var(--secondary-color);
}

.hero {
    background-color: var(--primary-color);
    background-image: var(--hero-overlay), var(--hero-image-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--secondary-color);
    padding: 100px 20px;
    text-align: center;
}

.hero h1 {
    font-size: 3rem;
    margin-bottom: 10px;
}

main {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
}

section {
    margin-bottom: 60px;
    text-align: center;
}

h2 {
    color: var(--primary-color);
    font-size: 2rem;
    margin-bottom: 20px;
}

.btn {
    display: inline-block;
    padding: 10px 20px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
    margin: 10px;
}

.btn-primary {
    background-color: var(--primary-color);
    color: var(--secondary-color);
}

.btn-secondary {
    background-color: transparent;
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
}

footer {
    text-align: center;
    padding: 20px;
    background-color: var(--primary-color);
    color: var(--secondary-color);
}
